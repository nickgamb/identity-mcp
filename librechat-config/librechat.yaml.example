version: 1.3.1

cache: true

# Copy to librechat.yaml (gitignored) and customize. See README.md.
modelSpecs:
  enforce: true
  prioritize: true
  list:
    - name: "letta-identity"
      label: "Identity (Letta memory)"
      description: "Stateful agent — self-editing memory + ambient recall over your history"
      default: true
      preset:
        endpoint: "Letta"
        model: "letta-identity"
        modelLabel: "letta-identity"

endpoints:
  custom:
    - name: "Letta"
      apiKey: "letta"
      baseURL: "http://letta-bridge:8284/v1"
      models:
        default:
          - "letta-identity"
        fetch: false
      titleConvo: false
      summarize: false
      forcePrompt: false
      modelDisplayLabel: "Letta (memory)"
      timeout: 1800000

  agents:
    recursionLimit: 50000
    maxRecursionLimit: 50000
    disableBuilder: false

mcpSettings:
  allowedDomains:
    - "mcp-server"
    - "http://mcp-server:4000"

mcpServers:
  identity-mcp:
    type: streamable-http
    url: http://mcp-server:4000/mcp-protocol
    timeout: 300000
    reconnect: true
    reconnectDelay: 2000
    maxReconnectAttempts: 10
